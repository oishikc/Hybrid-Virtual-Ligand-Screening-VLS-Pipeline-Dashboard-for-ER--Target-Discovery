# 1. Project-Specific Large Computational Files 

# Ignore the Windows Vina executable (other OS users must install their own)
vina
vina.exe

# Ignore heavy structural biology coordinate files
data/*.pdb
data/*.pdbqt

# Ignore folders containing thousands of individual conformer/docking outputs
data/docking_outputs/
data/ligands_pdbqt/

# Ignore massive deep learning model weights/checkpoints from DeepPurpose
save_folder/


# 2. Standard Python Template

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg


# 3. Virtual Environments (Prevents uploading your whole library folder)

venv/
.venv/
env/
.env/
ENV/
conda-env/

# 4. Operating System & IDE Specific Files

# Windows thumbnail databases and folder configs
Thumbs.db
desktop.ini

# macOS specific files
.DS_Store

# VS Code or PyCharm directories
.vscode/
.idea/
